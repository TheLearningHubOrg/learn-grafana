{
  "templating_list_addition": {
    "name": "handler",
    "label": "Handler",
    "type": "query",
    "datasource": { "type": "prometheus", "uid": "${datasource}" },
    "definition": "label_values(grafana_http_request_duration_seconds_count{job=~\"$job\", instance=~\"$instance\"}, handler)",
    "query": "label_values(grafana_http_request_duration_seconds_count{job=~\"$job\", instance=~\"$instance\"}, handler)",
    "regex": "/^\\/api\\/.*/",
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "allValue": "/api/.*",
    "current": {},
    "hide": 0
  },
  "repeated_panel": {
    "id": 12,
    "type": "timeseries",
    "title": "Request rate: $handler",
    "repeat": "handler",
    "repeatDirection": "h",
    "maxPerRow": 3,
    "gridPos": { "x": 0, "y": 37, "w": 8, "h": 6 },
    "datasource": { "type": "prometheus", "uid": "${datasource}" },
    "targets": [
      {
        "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "sum by (status_code) (rate(grafana_http_request_duration_seconds_count{job=\"grafana\", instance=~\"$instance\", handler=~\"$handler\"}[$__rate_interval]))",
        "legendFormat": "{{status_code}}",
        "range": true,
        "instant": false
      }
    ],
    "fieldConfig": {
      "defaults": {
        "unit": "reqps",
        "min": 0,
        "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal", "group": "A" } }
      },
      "overrides": []
    },
    "options": {
      "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
      "tooltip": { "mode": "multi", "sort": "desc" }
    }
  }
}
