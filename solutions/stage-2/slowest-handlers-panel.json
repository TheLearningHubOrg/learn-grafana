{
  "id": 11,
  "type": "bargauge",
  "title": "Slowest Grafana handlers (p95)",
  "gridPos": { "x": 0, "y": 29, "w": 12, "h": 8 },
  "datasource": { "type": "prometheus", "uid": "${datasource}" },
  "targets": [
    {
      "refId": "A",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "expr": "topk(5, histogram_quantile(0.95, sum by (handler, le) (rate(grafana_http_request_duration_seconds_bucket{job=\"grafana\", instance=~\"$instance\"}[$__rate_interval]))))",
      "legendFormat": "{{handler}}",
      "instant": true,
      "range": false
    }
  ],
  "fieldConfig": {
    "defaults": {
      "unit": "s",
      "min": 0,
      "decimals": 3,
      "color": { "mode": "thresholds" },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 0.25 },
          { "color": "red", "value": 1 }
        ]
      }
    },
    "overrides": []
  },
  "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "valueMode": "color",
    "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
  }
}
